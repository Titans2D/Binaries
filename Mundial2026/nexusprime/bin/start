#!/bin/sh
set -eu

cd "$(dirname "$0")"

if [ "${LD_LIBRARY_PATH:-}" = "" ]; then
  export LD_LIBRARY_PATH="$PWD/lib"
else
  export LD_LIBRARY_PATH="$PWD/lib:$LD_LIBRARY_PATH"
fi

host="${1:-localhost}"
player_number="${3:-0}"
port="${RCSS_PORT:-6000}"
coach_port="${RCSS_COACH_PORT:-6002}"
goalie_opt=""

if [ "$player_number" = "12" ] || [ "$player_number" = "coach" ]; then
  exec ./sample_coach \
    --coach-config ./coach.conf \
    -h "$host" \
    -p "$coach_port" \
    -t "NexusPrime" \
    --use_team_graphic on --team_graphic_file ./team-graphic.xpm \
    >/dev/null 2>&1
fi

if [ "$player_number" = "1" ]; then
  goalie_opt="-g"
fi

exec ./sample_player \
  --player-config ./player.conf \
  --config_dir ./formations-dt \
  -h "$host" \
  -p "$port" \
  -t "NexusPrime" \
  $goalie_opt \
  >/dev/null 2>&1
